<%- include('../partials/header', { title: 'Members', activePage: 'members' }) %>

<div class="container">
  <% if (dashboardAnnouncements && dashboardAnnouncements.length > 0) { %>
  <div class="dashboard-announcements">
    <div class="card-header">
      <h2>📢 Announcements</h2>
      <a href="/announcements" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="announcement-grid">
      <% dashboardAnnouncements.forEach(function(item) { %>
        <div class="announcement-card <%= item.isPinned ? 'pinned' : '' %>">
          <% if (item.isPinned) { %><span class="pin-badge">📌 Pinned</span><% } %>
          <% if (item.image) { %>
            <img src="<%= item.image %>" alt="<%= item.title %>" class="announcement-img">
          <% } %>
          <div class="announcement-body">
            <h3><%= item.title %></h3>
            <p><%= item.description.length > 120 ? item.description.substring(0, 120) + '...' : item.description %></p>
            <div class="announcement-meta">
              <span class="badge"><%= item.audience %><% if (item.audienceTarget) { %> · <%= item.audienceTarget %><% } %></span>
              <% if (item.startDate) { %>
                <span><%= item.startDate.toLocaleDateString() %></span>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div class="card-header">
    <h2>Church Members</h2>
    <a href="/members/create" class="btn btn-primary">+ Add New Member</a>
  </div>

  <form class="search-bar" method="GET" action="/members">
    <input type="text" name="search" placeholder="Search by name, email, or phone..." value="<%= search %>">
    <input type="text" name="department" class="filter-dept" placeholder="Filter by department..." value="<%= department %>">
    <button type="submit" class="btn btn-primary">Search</button>
    <% if (search || department) { %>
      <a href="/members" class="btn btn-secondary">Clear</a>
    <% } %>
  </form>

  <div class="card">
    <% if (members.length === 0) { %>
      <div class="empty-state">
        <p>No members found.</p>
        <a href="/members/create" class="btn btn-primary">Add Your First Member</a>
      </div>
    <% } else { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Member</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Department</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(function(member) { %>
              <tr>
                <td>
                  <a href="/members/<%= member._id %>" class="member-cell-link">
                    <% if (member.photo) { %>
                      <img src="<%= member.photo %>" alt="<%= member.firstName %>" class="member-thumb">
                    <% } else { %>
                      <div class="member-thumb member-thumb-initials">
                        <%= member.firstName.charAt(0) %><%= member.lastName.charAt(0) %>
                      </div>
                    <% } %>
                    <%= member.firstName %> <%= member.lastName %>
                  </a>
                </td>
                <td><%= member.email || '-' %></td>
                <td><%= member.phone || '-' %></td>
                <td><%= member.department || '-' %></td>
                <td>
                  <div class="actions">
                    <a href="/members/<%= member._id %>" class="btn btn-sm btn-primary">View</a>
                    <a href="/members/<%= member._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                    <form action="/members/<%= member._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this member?')">
                      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="/members?page=<%= currentPage - 1 %>&search=<%= search %>&department=<%= department %>">« Prev</a>
          <% } %>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="active"><%= i %></span>
            <% } else { %>
              <a href="/members?page=<%= i %>&search=<%= search %>&department=<%= department %>"><%= i %></a>
            <% } %>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/members?page=<%= currentPage + 1 %>&search=<%= search %>&department=<%= department %>">Next »</a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
