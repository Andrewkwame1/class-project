<%- include('../partials/header', { title: devotional.title, activePage: 'devotionals' }) %>

<div class="container">
  <div class="card-header">
    <h2>Devotional Details</h2>
    <div>
      <a href="/devotionals/<%= devotional._id %>/edit" class="btn btn-primary">Edit</a>
      <a href="/devotionals" class="btn btn-secondary">← Back to List</a>
    </div>
  </div>

  <div class="card">
    <div class="devotional-content" style="padding: 20px;">
      <h1 style="margin-bottom: 10px;"><%= devotional.title %></h1>
      
      <div style="margin-bottom: 20px; color: #666; font-size: 0.9em;">
        <% if (devotional.bibleVerse) { %>
          <strong>Scripture:</strong> <%= devotional.bibleVerse %><br>
        <% } %>
        <% if (devotional.author) { %>
          <strong>Author:</strong> <%= devotional.author %><br>
        <% } %>
        <strong>Status:</strong> <%= devotional.isPublished ? 'Published' : 'Draft' %>
      </div>

      <% if (devotional.scriptureText) { %>
        <blockquote style="border-left: 4px solid #0056b3; padding-left: 15px; margin-bottom: 20px; font-style: italic; color: #555;">
          "<%= devotional.scriptureText %>"
        </blockquote>
      <% } %>

      <div class="message" style="margin-bottom: 30px; line-height: 1.6;">
        <h3 style="margin-bottom: 10px;">Message</h3>
        <p style="white-space: pre-wrap;"><%= devotional.message %></p>
      </div>

      <% if (devotional.prayer) { %>
        <div class="prayer" style="margin-bottom: 20px; background-color: #f8f9fa; padding: 15px; border-radius: 5px;">
          <h4 style="margin-bottom: 10px;">Prayer</h4>
          <p style="white-space: pre-wrap; margin: 0;"><%= devotional.prayer %></p>
        </div>
      <% } %>

      <% if (devotional.reflectionQuestion) { %>
        <div class="reflection" style="margin-bottom: 20px; background-color: #e9ecef; padding: 15px; border-radius: 5px;">
          <h4 style="margin-bottom: 10px;">Reflection Question</h4>
          <p style="margin: 0;"><%= devotional.reflectionQuestion %></p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
