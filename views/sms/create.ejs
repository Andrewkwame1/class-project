<%- include('../partials/header', { title: 'Create SMS Alert', activePage: 'sms' }) %>

<div class="container">
  <div class="card-header">
    <h2>Create SMS Alert</h2>
    <a href="/sms" class="btn btn-secondary">← Back</a>
  </div>

  <div class="card">
    <form action="/sms/create" method="POST">
      <div class="form-group">
        <label>Internal Title (Not sent in SMS) *</label>
        <input type="text" name="title" placeholder="e.g. Youth Camp Reminder" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Audience</label>
          <select name="audience" id="audienceSelect" class="audience-select">
            <option value="Entire church">Entire church</option>
            <option value="Men">Men</option>
            <option value="Women">Women</option>
            <option value="Youth">Youth</option>
            <option value="Children">Children</option>
            <option value="Department">Specific Department</option>
            <option value="Branch">Specific Branch</option>
          </select>
        </div>
        <div class="form-group audience-target-group" id="audienceTargetGroup" hidden>
          <label id="audienceTargetLabel">Target Name</label>
          <input type="text" name="audienceTarget" placeholder="Enter target name">
        </div>
      </div>

      <div class="form-group">
        <label>SMS Message *</label>
        <textarea name="message" rows="4" placeholder="Type your SMS message here. Keep it concise." required></textarea>
        <small class="text-muted">SMS messages are typically limited to 160 characters per segment.</small>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="draft">Draft</option>
            <option value="scheduled">Scheduled</option>
          </select>
        </div>
        <div class="form-group">
          <label>Scheduled Date (Optional)</label>
          <input type="date" name="scheduledDate">
        </div>
      </div>

      <button type="submit" class="btn btn-success">Save SMS Alert</button>
      <a href="/sms" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>

<script src="/js/audience-select.js"></script>
<%- include('../partials/footer') %>
