<%- include('../partials/header', { title: 'Announcements', activePage: 'announcements' }) %>

<div class="container">
  <div class="card-header">
    <h2>Announcements</h2>
    <a href="/announcements/create" class="btn btn-primary">+ Create Announcement</a>
  </div>

  <form class="search-bar" method="GET" action="/announcements">
    <input type="text" name="search" placeholder="Search announcements..." value="<%= search %>">
    <select name="audience" class="filter-dept">
      <option value="">All Audiences</option>
      <option value="Entire church" <%= audience === 'Entire church' ? 'selected' : '' %>>Entire church</option>
      <option value="Men" <%= audience === 'Men' ? 'selected' : '' %>>Men</option>
      <option value="Women" <%= audience === 'Women' ? 'selected' : '' %>>Women</option>
      <option value="Youth" <%= audience === 'Youth' ? 'selected' : '' %>>Youth</option>
      <option value="Children" <%= audience === 'Children' ? 'selected' : '' %>>Children</option>
      <option value="Department" <%= audience === 'Department' ? 'selected' : '' %>>Department</option>
      <option value="Branch" <%= audience === 'Branch' ? 'selected' : '' %>>Branch</option>
    </select>
    <select name="status" class="filter-dept">
      <option value="">All Status</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="scheduled" <%= status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
      <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired</option>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    <% if (search || audience || status) { %>
      <a href="/announcements" class="btn btn-secondary">Clear</a>
    <% } %>
  </form>

  <div class="card">
    <% if (announcements.length === 0) { %>
      <div class="empty-state">
        <p>No announcements found.</p>
        <a href="/announcements/create" class="btn btn-primary">Create Your First Announcement</a>
      </div>
    <% } else { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Audience</th>
              <th>Status</th>
              <th>Dates</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% announcements.forEach(function(announcement) { %>
              <tr class="<%= announcement.isPinned ? 'row-pinned' : '' %>">
                <td>
                  <div class="title-cell">
                    <% if (announcement.isPinned) { %><span class="pin-icon" title="Pinned">📌</span><% } %>
                    <% if (announcement.image) { %>
                      <img src="<%= announcement.image %>" alt="" class="table-thumb">
                    <% } %>
                    <strong><%= announcement.title %></strong>
                  </div>
                </td>
                <td>
                  <%= announcement.audience %>
                  <% if (announcement.audienceTarget) { %>
                    <small>(<%= announcement.audienceTarget %>)</small>
                  <% } %>
                </td>
                <td>
                  <span class="status-badge status-<%= announcement.effectiveStatus %>">
                    <%= announcement.effectiveStatus.charAt(0).toUpperCase() + announcement.effectiveStatus.slice(1) %>
                  </span>
                </td>
                <td>
                  <% if (announcement.startDate) { %>From <%= announcement.startDate.toLocaleDateString() %><br><% } %>
                  <% if (announcement.endDate) { %>To <%= announcement.endDate.toLocaleDateString() %><% } %>
                </td>
                <td>
                  <div class="actions">
                    <a href="/announcements/<%= announcement._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                    <form action="/announcements/<%= announcement._id %>/status" method="POST" class="inline-form">
                      <input type="hidden" name="status" value="<%= announcement.effectiveStatus === 'expired' ? 'active' : 'expired' %>">
                      <button type="submit" class="btn btn-sm btn-secondary"><%= announcement.effectiveStatus === 'expired' ? 'Activate' : 'Expire' %></button>
                    </form>
                    <form action="/announcements/<%= announcement._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this announcement?')">
                      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
